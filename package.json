{
  "name": "netcontrol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check": "tsc -b && eslint .",
    "tauri": "tauri",
    "format": "prettier --write src scripts *.json *.ts *.js .github/**/*.yml docs/*.md README.md CONTRIBUTING.md SECURITY.md",
    "format:check": "prettier --check src scripts",
    "notices": "node scripts/collect-notices.mjs",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.0"
  },
  "license": "MIT",
  "author": "Yaser Zarifi",
  "repository": {
    "type": "git",
    "url": "https://github.com/YaserZarifi/NetControl.git"
  }
}
